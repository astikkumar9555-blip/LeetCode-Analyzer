 PORT=5000

# Frontend address(es) allowed to call this server (comma separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Long random string. Change it! (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_string

# ---- Email for OTP codes ----
# Gmail: turn on 2-step verification, then create an "App password" and paste it below.
# If SMTP_USER / SMTP_PASS are empty, the OTP is printed in this server's terminal instead (good for testing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LeetCode Analyzer <your_email@gmail.com>"